{
  "flow": "site-project",
  "version": 1,
  "state": {
    "gate": {}
  },
  "nodes": [
    {
      "id": "research",
      "kind": "agent",
      "craft": [
        "skills/sourcing-from-docs"
      ],
      "out": [
        "research.md"
      ]
    },
    {
      "id": "gate-research",
      "kind": "gate",
      "run": "{worktable}/bin/gate-then-status.py {feature_dir} researched -- {worktable}/bin/item-check.py {feature_dir} research"
    },
    {
      "id": "brief",
      "kind": "agent",
      "craft": [
        "skills/spec-authoring"
      ],
      "in": [
        "research.md"
      ],
      "out": [
        "brief.md"
      ]
    },
    {
      "id": "gate-brief",
      "kind": "gate",
      "run": "{worktable}/bin/gate-then-status.py {feature_dir} briefed -- {worktable}/bin/item-check.py {feature_dir} brief"
    },
    {
      "id": "review",
      "kind": "agent",
      "craft": [
        "agents/reviewer"
      ],
      "in": [
        "brief.md",
        "research.md"
      ],
      "out": [
        "reviews/brief.md"
      ]
    },
    {
      "id": "gate-review",
      "kind": "gate",
      "run": "{worktable}/bin/gate-then-status.py {feature_dir} reviewed --seal brief -- {worktable}/bin/review-check.py {feature_dir} brief"
    },
    {
      "id": "approve",
      "kind": "human",
      "out": [
        "seal launch"
      ]
    },
    {
      "id": "gate-seal",
      "kind": "gate",
      "run": "{worktable}/bin/gate-then-status.py {feature_dir} live -- {netdust_flow}/bin/seal.py check {feature_dir} launch --fresh"
    }
  ],
  "edges": [
    {
      "from": "__start__",
      "to": "research"
    },
    {
      "from": "research",
      "to": "gate-research"
    },
    {
      "from": "gate-research",
      "to": "brief",
      "when": "gate.exit == 0"
    },
    {
      "from": "gate-research",
      "to": "research",
      "when": "gate.exit != 0"
    },
    {
      "from": "brief",
      "to": "gate-brief"
    },
    {
      "from": "gate-brief",
      "to": "review",
      "when": "gate.exit == 0"
    },
    {
      "from": "gate-brief",
      "to": "brief",
      "when": "gate.exit != 0"
    },
    {
      "from": "review",
      "to": "gate-review"
    },
    {
      "from": "gate-review",
      "to": "approve",
      "when": "gate.exit == 0"
    },
    {
      "from": "gate-review",
      "to": "brief",
      "when": "gate.exit != 0"
    },
    {
      "from": "approve",
      "to": "gate-seal"
    },
    {
      "from": "gate-seal",
      "to": "__end__",
      "when": "gate.exit == 0"
    },
    {
      "from": "gate-seal",
      "to": "brief",
      "when": "gate.exit == 2"
    },
    {
      "from": "gate-seal",
      "to": "approve",
      "when": "gate.exit == 1"
    }
  ]
}
